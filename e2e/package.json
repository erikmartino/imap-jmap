{
  "name": "imap-jmap-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end tests driving the Bulwark webmail client against the imap-jmap server. Not part of ordinary (go test) testing.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:tldr": "bash scripts/tldr.sh",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:calendar": "playwright test calendar",
    "test:report": "playwright show-report",
    "install:browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker-compose -f ../docker-compose.bulwark.yml up -d --build",
    "docker:down": "docker-compose -f ../docker-compose.bulwark.yml down",
    "docker:logs": "docker-compose -f ../docker-compose.bulwark.yml logs -f"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2"
  }
}
