hosts = ldap:389
dn = cn=admin,dc=profundo,dc=dk
dnpass = admin
auth_bind = yes
auth_bind_userdn = uid=%u,ou=users,dc=profundo,dc=dk
base = ou=users,dc=profundo,dc=dk
user_attrs = mail=user
user_filter = (|(uid=%u)(mail=%u))
pass_attrs = uid=user,userPassword=password
pass_filter = (|(uid=%u)(mail=%u))
